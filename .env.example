# Gemini runs Search, Reader, and Writer.
GOOGLE_API_KEY=

# Groq is optional and runs the Critic stage.
# GROQ_API_KEY=

# Optional model settings
# GROQ_MODEL=openai/gpt-oss-20b
# MAX_OUTPUT_TOKENS=1400
# GOOGLE_MODEL=gemini-3.6-flash

# Optional: enables the General web source in addition to OpenAlex and news RSS
# TAVILY_API_KEY=
