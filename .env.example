# Configure at least one model provider. InsightForge checks them in this order:
GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-20b
# MAX_OUTPUT_TOKENS=1400
# GOOGLE_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini

# Optional: enables the General web source in addition to OpenAlex and news RSS
# TAVILY_API_KEY=
